<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Markout</RootNamespace>
    <Description>A source-generated Markdown serializer for .NET</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Version>0.24.0</Version>
    <PackageReleaseNotes>[#153] Goal and polarity now render as configurable glyphs on rich sinks (Markdown/ANSI/Unicode). A MetricChange&lt;T&gt; metric label carries a goal glyph (↑ higher-is-better / ↓ lower-is-better) and its Change cell a derived polarity glyph (✓/✗) instead of the (+)/(-) marker and good/bad word. A MultiSourceRow with a Goal adds a pairwise polarity glyph to each scalar column (compared to its previous populated column) — a per-period trend over an n-column series — plus the goal glyph on the label. Glyphs are configurable via MarkoutWriterOptions.Glyphs (defaults ↑/↓/✓/✗); a caller StatusLabel stays a word. Plain text keeps the ASCII (-)/(+) marker and status word, and TSV/JSONL keep the direction/status slug words, so machine-readable and non-Unicode output are unchanged.</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\MarkdownTable.Formatting\MarkdownTable.Formatting.csproj" />
  </ItemGroup>

  <!-- Include source generator in this package -->
  <ItemGroup>
    <ProjectReference Include="..\Markout.SourceGeneration\Markout.SourceGeneration.csproj"
                      PrivateAssets="all"
                      ReferenceOutputAssembly="false"
                      OutputItemType="Analyzer" />
  </ItemGroup>

  <!-- Pack the source generator into analyzers folder -->
  <ItemGroup>
    <None Include="$(ArtifactsPath)\bin\Markout.SourceGeneration\$(Configuration.ToLowerInvariant())\Markout.SourceGeneration.dll"
          Pack="true"
          PackagePath="analyzers/dotnet/cs"
          Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)..\..\README.md"
          Pack="true"
          PackagePath="\" />
    <!-- Consumer/package grounding shipped at the nupkg root. Sourced from grounding/markout/
         (NOT the repo-root AGENTS.md, which is maintainer guidance). dotnet-inspect (readme)
         and the NuGet MCP resolve this AGENTS.md ahead of the human README.md. -->
    <None Include="$(MSBuildThisFileDirectory)..\..\grounding\markout\AGENTS.md"
          Pack="true"
          PackagePath="\" />
  </ItemGroup>

</Project>
